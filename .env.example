# Execute python scripts/init_env.py para gerar segredos locais.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://aegis:GENERATE@localhost:18782/aegis
REDIS_URL=redis://:GENERATE@localhost:18783/0
PUBLIC_ORIGIN=http://localhost:18780
SECURE_COOKIES=false
