{
  "name": "aegis-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18780",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "e2e": "cd ../.. && .venv/bin/python scripts/e2e.py",
