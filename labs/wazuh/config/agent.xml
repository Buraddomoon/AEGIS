<ossec_config>
  <client>
    <server><address>wazuh.manager</address><port>1514</port><protocol>tcp</protocol></server>
    <notify_time>10</notify_time><time-reconnect>10</time-reconnect>
    <crypto_method>aes</crypto_method>
    <enrollment><enabled>no</enabled></enrollment>
  </client>
  <rootcheck><disabled>yes</disabled></rootcheck>
  <syscheck><disabled>yes</disabled></syscheck>
  <sca><enabled>no</enabled></sca>
  <wodle name="syscollector"><disabled>yes</disabled></wodle>
  <active-response><disabled>yes</disabled></active-response>
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/aegis/observations.jsonl</location>
  </localfile>
  <logging><log_format>plain</log_format></logging>
</ossec_config>
